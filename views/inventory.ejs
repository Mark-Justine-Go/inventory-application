<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/inventory.css">
    <title>Inventory</title>
</head>
<body>
    <%- include("./header.ejs") %>
    <div id="inventoryContainer">
        <div>
            <h1>Product Inventory</h1>
            <div>
                <button>New Product</button>
                <button>New Category</button>
            </div>
        </div>
        <div id="productTable">
            <table>
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Product Name</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Description</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.map(product => {%>
                        <tr>
                            <form action="/inventory" method="post">
                                <td><%= product.category_id %></td>
                                <td><%= product.product_name %></td>
                                <td>$<input type="number" value="<%= product.price %>" name="price"></td>
                                <td><input type="number" value="<%= product.quantity %>" name="quantity"></td>
                                <td>
                                    <input type="hidden" value="<%= product.id %>" name="id">
                                    <input type="text" value="<%= product.description %>" name="description">
                                    <button type="submit" class="formButton" value="save" name="type"><img src="/assets/save.svg" alt="delete icon" class="icon"></button>
                                    <button type="submit" class="formButton" value="delete" name="type"><img src="/assets/delete.svg" alt="save icon" class="icon"></button>
                                </td>
                            </form>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
    <script>
    document.write('<script src="http://' + (location.host || 'localhost').split(':')[0] +':35729/livereload.js?snipver=1"></' + 'script>')
    </script>
</body>
</html>